<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- « Utiliser ma position »: approximate only, asked when touched, rounded to about 1 km before it leaves the phone. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The notifications (Android 13 and later): asked when the person turns them on, never at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Vigie">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- « Vigie · mon lieu », the place widget, and the choice of its place when it is placed. -->
        <receiver
            android:name=".widget.PlaceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_place_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_place_info" />
        </receiver>
        <!-- « Vigie · la frise », the next hours of a place drawn as the hours tab; same choice of place. -->
        <receiver
            android:name=".widget.FriseWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_frise_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_frise_info" />
        </receiver>
        <!-- The notifications (Firebase Cloud Messaging): no registration token is made before the person turns
             them on (auto-init off, analytics off as the docs ask), and Android shows a message the app did not
             name a category for in « Autres alertes ». -->
        <service
            android:name=".notify.VigieMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="vigie-alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
