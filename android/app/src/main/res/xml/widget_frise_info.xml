<?xml version="1.0" encoding="utf-8"?>
<!--
  « Vigie · la frise »: the site's small widget at every size (BoardArt.frise): four cells by two when placed; taller,
  the frise drawn larger, the days under the hours from about four rows. Never narrower than three cells: the box of
  the hour and its columns need their width. Redrawn as the place widget (WidgetRefresh); the place and the next hours
  or days are chosen when it is placed, and again later.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="fr.auxfilsdesidees.vigie.widget.WidgetConfigActivity"
    android:description="@string/widget_frise_about"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="200dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
