<?xml version="1.0" encoding="utf-8"?>
<!--
  « Vigie · mon lieu »: four cells by two when placed, from two by one to the whole screen. No update period: the app
  and a half-hourly WorkManager job redraw it (WidgetRefresh). The place is chosen when it is placed, and again later.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="fr.auxfilsdesidees.vigie.widget.WidgetConfigActivity"
    android:description="@string/widget_place_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
