# Vigie API (repository Axellum/vigie-api), image built on the server from origin/main (deploy.sh api).
# Reachable on port 8080 of the server: the home displays and Home Assistant read it there.
[Unit]
Description=Vigie API (port 8080)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/vigie-api:current
ContainerName=vigie-api
Network=vigie.network
PublishPort=8080:8080
Volume=vigie-api-data:/data
# Settings of this instance (VIGIE_CONTACT, the contact sent to the providers): ~/vigie/api.env, made by hand
# once and left alone by deploy.sh.
EnvironmentFile=%h/vigie/api.env
# The NASA FIRMS key (fires), from a Podman secret: its value is in no file of this repository. Created once:
#   <read VIGIE_FIRMS_MAP_KEY from the owner's .env> | podman secret create --replace vigie_firms_map_key -
Secret=vigie_firms_map_key,type=env,target=VIGIE_FIRMS_MAP_KEY
# The admin token (ADR 0009 of the API): a request that is not a read must carry it, else 401. Same way:
#   <read VIGIE_ADMIN_TOKEN from the owner's .env> | podman secret create --replace vigie_admin_token -
Secret=vigie_admin_token,type=env,target=VIGIE_ADMIN_TOKEN
# A quadlet HealthCmd with quotes is mangled, hence a small script mounted read-only.
Volume=%h/vigie/api-healthcheck.py:/healthcheck.py:ro
HealthCmd=python /healthcheck.py
HealthInterval=60s
HealthStartPeriod=30s

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target
