# Caddy on the Deck (quadlet: ~/.config/containers/systemd/caddy.container): the only door to Vigie Web.
# Host network: it sees the visitors' real addresses (a published port of a rootless bridge network would
# show the network's gateway instead) and reaches the site on 127.0.0.1:3000.
[Unit]
Description=Caddy for Vigie Web
Wants=network-online.target vigie-web.service
After=network-online.target vigie-web.service

[Container]
Image=docker.io/library/caddy:2.11.7-alpine
ContainerName=vigie-caddy
Network=host
Volume=%h/vigie/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=vigie-caddy-data:/data
Volume=vigie-caddy-config:/config

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target
