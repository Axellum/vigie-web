# Copy to ~/vigie/api.env on the server (deploy.sh files does it once, then leaves it alone).
# Settings of the API: "Configuration" in the README of Axellum/vigie-api.
# MET Norway and NOAA ask for an identifying contact in the User-Agent: an e-mail address or a URL.
VIGIE_CONTACT=https://github.com/Axellum/vigie-api
# This instance serves other people: MetService's terms allow personal use only. (RainViewer is already off in
# the image.)
VIGIE_ENABLE_METSERVICE=0
