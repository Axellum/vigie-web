# Vigie Web on the server (quadlet: ~/.config/containers/systemd/vigie-web.container).
# Reachable only from the server itself (127.0.0.1:3000): Caddy is the one door, see caddy.container.
[Unit]
Description=Vigie Web (127.0.0.1:3000)
Wants=network-online.target vigie-api.service vigie-db.service
After=network-online.target vigie-api.service vigie-db.service

[Container]
Image=localhost/vigie-web:current
ContainerName=vigie-web
Network=vigie.network
PublishPort=127.0.0.1:3000:3000
Environment=VIGIE_API_URL=http://vigie-api:8080
# Caddy adds the visitor's address to X-Forwarded-For: the rate limit reads it there.
Environment=ADDRESS_HEADER=X-Forwarded-For
Environment=XFF_DEPTH=1
# The scheme visitors use (SvelteKit 3 no longer reads ORIGIN): Caddy says it in X-Forwarded-Proto, the host
# comes with the request. Forms and passkeys compare it with the browser's origin.
Environment=PROTOCOL_HEADER=X-Forwarded-Proto
# The accounts' database. Its URL holds the password, hence a Podman secret (deploy.sh secrets).
Secret=vigie_database_url,type=env,target=DATABASE_URL
# The keys that sign the notifications (deploy.sh vapid-public, vapid-private). Without them, no notification.
Secret=vigie_vapid_public_key,type=env,target=VIGIE_VAPID_PUBLIC_KEY
Secret=vigie_vapid_private_key,type=env,target=VIGIE_VAPID_PRIVATE_KEY
# ORIGIN (the address visitors use) is machine-specific: ~/vigie/web.env, see web.env.example.
EnvironmentFile=%h/vigie/web.env
Volume=%h/vigie/web-healthcheck.mjs:/healthcheck.mjs:ro
HealthCmd=node /healthcheck.mjs
HealthInterval=60s
HealthStartPeriod=20s

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target
