# Caddy with the rate limit module (mholt/caddy-ratelimit), which the standard image does not have. Built on the
# server by deploy.sh caddy; the module is pinned to a commit, Caddy to the same version as before.
FROM docker.io/library/caddy:2.11.7-builder-alpine AS builder
RUN xcaddy build --with github.com/mholt/caddy-ratelimit@5625512f24f6f59d6f64fb3aafe5eecff0b286db

FROM docker.io/library/caddy:2.11.7-alpine
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
