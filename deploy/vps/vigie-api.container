# Vigie API (repository Axellum/vigie-api), image built on the server from origin/main (deploy.sh api).
# The site reads it on the internal network (vigie-api:8080); Caddy opens its reads to everybody under /v1, on
# 127.0.0.1:8082 (see the Caddyfile). Its write routes stay out of reach: Caddy answers 405, the API 401 without
# its admin token.
[Unit]
Description=Vigie API (127.0.0.1:8082)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/vigie-api:current
ContainerName=vigie-api
Network=vigie.network
PublishPort=127.0.0.1:8082:8080
Volume=vigie-api-data:/data
# Settings of this instance (contact, sources turned off for a public instance): ~/vigie/api.env, see api.env.example.
EnvironmentFile=%h/vigie/api.env
# The NASA FIRMS key (fires), from a Podman secret (deploy.sh firms-key): its value is in no file of this repository.
Secret=vigie_firms_map_key,type=env,target=VIGIE_FIRMS_MAP_KEY
# The admin token (ADR 0009 of the API): a request that is not a read must carry it, else 401 (deploy.sh admin-token).
Secret=vigie_admin_token,type=env,target=VIGIE_ADMIN_TOKEN
# A quadlet HealthCmd with quotes is mangled, hence a small script mounted read-only.
Volume=%h/vigie/api-healthcheck.py:/healthcheck.py:ro
HealthCmd=python /healthcheck.py
HealthInterval=60s
HealthStartPeriod=30s

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=180
# The network the containers share forgets a connection that the far end has closed after 60 seconds
# (nf_conntrack_tcp_timeout_close_wait). The API closes its side of such a connection only at its next request to that
# source, often minutes later; netavark then drops that FIN as invalid, pasta never sees it and keeps the connection for
# good, and every later connection from the same source port is lost. A day covers the API's gaps between requests to
# a source. The setting lives in that network, made anew only when every container has stopped, and the API runs while
# it exists: setting it at each start of the API is enough. "-": a failure leaves the API running, the journal says it.
ExecStartPost=-/usr/bin/podman unshare --rootless-netns /usr/sbin/sysctl -q -w net.netfilter.nf_conntrack_tcp_timeout_close_wait=86400

[Install]
WantedBy=default.target
