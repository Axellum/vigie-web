# PostgreSQL with PostGIS, for the accounts of the site (quadlet: ~/.config/containers/systemd/vigie-db.container).
# No published port: only the site reaches it, on the internal network (vigie-db:5432).
# Stay on PostgreSQL 18: a new major version needs a dump and a restore (README.md, "Backups").
[Unit]
Description=Vigie database (accounts)
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/postgis/postgis:18-3.6
ContainerName=vigie-db
Network=vigie.network
# PostgreSQL 18 images keep their data under /var/lib/postgresql/18/docker: the volume is their parent.
Volume=vigie-db-data:/var/lib/postgresql
Environment=POSTGRES_USER=vigie
Environment=POSTGRES_DB=vigie
# The password, from a Podman secret made on the server (deploy.sh secrets): it is in no file of this repository.
# It is read once, when the volume is created.
Secret=vigie_db_password
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/vigie_db_password
HealthCmd=pg_isready -h 127.0.0.1 -U vigie -d vigie
HealthInterval=60s
HealthStartPeriod=30s
StopTimeout=60

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=default.target
