{
	"name": "vigie-web",
	"private": true,
	"type": "module",
	"description": "Website for the Vigie API: world hazards and official weather warnings on maps.",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"record-fixtures": "node scripts/record-fixtures.mjs"
	},
	"dependencies": {
		"@fontsource/barlow-semi-condensed": "5.3.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@fontsource/ibm-plex-sans": "5.3.0",
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.0.3",
		"maplibre-gl": "6.14.0",
		"postgres": "3.4.9",
		"web-push": "3.6.7"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.5.8",
		"@electric-sql/pglite-postgis": "0.2.8",
		"@electric-sql/pglite-socket": "0.2.11",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "22.20.5",
		"@types/web-push": "3.6.4",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "3.5.2",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "^6.0.0",
		"vite": "^8.0.12",
		"vitest": "4.1.12"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
